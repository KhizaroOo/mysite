<!DOCTYPE html>
<html lang="en">
<head>
	<meta name="author" content="khizooo">
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
	<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon_32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="/images/favicon_16x16.png">
	<link rel="canonical" href="@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path" />
	<title>@ViewData["Title"]</title>
	<meta name="description" content="@ViewData["Description"]" />
	<meta name="keywords" content="@ViewData["Keywords"]" />
	<meta property="og:title" content="@ViewData["Title"]" />
	<meta property="og:description" content="@ViewData["Description"]" />
	<meta property="og:image" content="@ViewData["Image"]" />
	<link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/all.min.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/plugins.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/khizooo.css" asp-append-version="true" />
</head>
<body style="background:#eeeeee">
	<partial name="PV/_screenLoader" />
	<div class="khizooo_tm_all_wrap" data-magic-cursor="show">
		<partial name="PV/_sidebar"/>
		<partial name="PV/_mobileMenu" />
		<div class="khizooo_tm_mainpart">
			@RenderBody()
			<partial name="PV/_footer" />
		</div>
        <partial name="PV/_backgroundEffects" />
	</div>
    <partial name="PV/_cursor" />
    <partial name="PV/_topup" />
	<script src="~/js/jquery.js" defer asp-append-version="true"></script>
	<script src="~/js/bootstrap.bundle.min.js" defer asp-append-version="true"></script>
	<script src="~/js/plugins.js" defer asp-append-version="true"></script>
	<script src="~/js/init.js" defer asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>